{
  "name": "jumca-portal",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx turbo dev",
    "build": "npx turbo build",
    "lint": "npx oxlint",
    "lint:fix": "npx oxlint --fix",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "client:dev": "npm --workspace @jumca/client run dev",
    "server:dev": "npm --workspace @jumca/server run dev",
    "client:build": "npm --workspace @jumca/client run build",
    "server:build": "npm --workspace @jumca/server run build",
    "server:prisma:generate": "npm --workspace @jumca/server run db:generate",
    "server:prisma:migrate": "npm --workspace @jumca/server run db:migrate",
    "server:prisma:studio": "npm --workspace @jumca/server run db:studio",
    "server:prisma:seed": "npm --workspace @jumca/server run db:seed",
    "prepare": "husky"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma": true,
    "bcrypt": true,
    "esbuild": true,
    "husky": true
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lusca": "^1.7.5",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.3",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13"
  },
  "packageManager": "npm@12.2.3",
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "express-session": "^1.19.0",
    "lusca": "^1.7.0",
    "react-router-dom": "^7.18.7"
  }
}
